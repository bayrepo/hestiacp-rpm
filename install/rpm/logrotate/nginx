/var/log/nginx/*log /var/log/nginx/domains/*log /usr/local/hestia/nginx-system/var/log/nginx/*log {
    rotate 4
    weekly
    missingok
    notifempty
    compress
    delaycompress
    create 640
    sharedscripts
    postrotate
        [ -f /run/nginx-system.pid ] && kill -USR1 `cat /run/nginx-system.pid`
        endscript
}
